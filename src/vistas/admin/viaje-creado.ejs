<%- include('../parciales/encabezado', { titulo: titulo }) %>

<h1><%= titulo %></h1>
<p class="mensaje-exito" role="status">
  <% if (viaje.estado === 'Publicado') { %>El viaje <%= viaje.idViaje %> quedó publicado en la cartelera.
  <% } else if (viaje.estadoAprobacion === 'Pendiente') { %>El viaje <%= viaje.idViaje %> está pendiente de aprobación.
  <% } else { %>El viaje <%= viaje.idViaje %> no está publicado.<% } %>
</p>

<article class="detalle-viaje">
  <dl>
    <dt>Evento</dt>
    <dd><%= viaje.eventoNombre %></dd>
    <dt>Fecha del evento</dt>
    <dd><%= viaje.eventoFecha %></dd>
    <dt>Fecha del viaje</dt>
    <dd><%= viaje.fechaViaje %></dd>
    <dt>Hora de salida</dt>
    <dd><%= viaje.horaSalida %></dd>
    <dt>Hora de regreso</dt>
    <dd><%= viaje.horaRegreso %></dd>
    <dt>Lugar de encuentro</dt>
    <dd><%= viaje.lugarEncuentro %></dd>
    <dt>Costo</dt>
    <dd><%= formatearMonto(viaje.costo) %></dd>
    <dt>Conductor</dt>
    <dd><%= viaje.conductorAsignado %></dd>
    <dt>Asistente</dt>
    <dd><%= viaje.asistenteAsignado %></dd>
    <dt>Vehículo</dt>
    <dd><%= viaje.vehiculoModelo %> · patente <%= viaje.vehiculoPatente %></dd>
    <dt>Estado</dt>
    <dd><%= viaje.estado %></dd>
    <dt>Estado de aprobación</dt>
    <dd><%= viaje.estadoAprobacion %></dd>
  </dl>
  <p class="cupos">Cupos disponibles: <%= viaje.cuposDisponibles %> de <%= viaje.capacidad %></p>
</article>

<p>
  <a class="boton" href="/cartelera">Ver cartelera</a>
  <a class="volver" href="/admin/viajes/<%= viaje.idViaje %>">Consultar estado de aprobación</a>
  <% if (viaje.estado === 'Publicado') { %><a class="volver" href="/cartelera/<%= viaje.idViaje %>">Ver detalle del viaje</a><% } %>
</p>

<%- include('../parciales/pie') %>
