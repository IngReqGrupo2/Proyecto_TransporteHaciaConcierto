<%- include('parciales/encabezado', { titulo: titulo }) %>

<h1>Cartelera de viajes</h1>
<p class="intro">Consulta los viajes publicados y los cupos disponibles antes de reservar.</p>

<% if (viajes.length === 0) { %>
  <p class="mensaje-vacio" role="status">No hay viajes disponibles</p>
<% } else { %>
  <section class="lista-viajes">
    <% viajes.forEach((viaje) => { %>
      <article class="tarjeta-viaje">
        <h2><a href="/cartelera/<%= viaje.idViaje %>"><%= viaje.eventoNombre %></a></h2>
        <dl>
          <dt>Fecha del evento</dt>
          <dd><%= viaje.eventoFecha %></dd>
          <dt>Fecha del viaje</dt>
          <dd><%= viaje.fechaViaje %></dd>
          <dt>Hora de salida</dt>
          <dd><%= viaje.horaSalida %></dd>
          <dt>Hora de regreso</dt>
          <dd><%= viaje.horaRegreso %></dd>
          <dt>Lugar de encuentro</dt>
          <dd><%= viaje.lugarEncuentro %></dd>
          <dt>Costo</dt>
          <dd><%= formatearMonto(viaje.costo) %></dd>
        </dl>
        <p class="cupos">Cupos disponibles: <%= viaje.cuposDisponibles %></p>
        <a class="boton" href="/cartelera/<%= viaje.idViaje %>">Ver detalle</a>
      </article>
    <% }); %>
  </section>
<% } %>

<%- include('parciales/pie') %>
