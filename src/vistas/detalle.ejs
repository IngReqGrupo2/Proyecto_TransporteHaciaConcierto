<%- include('parciales/encabezado', { titulo: titulo }) %>

<p><a class="volver" href="/cartelera">← Volver a la cartelera</a></p>

<article class="detalle-viaje">
  <h1><%= viaje.eventoNombre %></h1>
  <dl>
    <dt>Fecha del evento</dt>
    <dd><%= viaje.eventoFecha %></dd>
    <dt>Fecha del viaje</dt>
    <dd><%= viaje.fechaViaje %></dd>
    <dt>Hora de salida</dt>
    <dd><%= viaje.horaSalida %></dd>
    <dt>Hora de regreso</dt>
    <dd><%= viaje.horaRegreso %></dd>
    <dt>Lugar de encuentro</dt>
    <dd><%= viaje.lugarEncuentro %></dd>
    <dt>Costo</dt>
    <dd><%= formatearMonto(viaje.costo) %></dd>
  </dl>
  <p class="cupos">Cupos disponibles: <%= viaje.cuposDisponibles %></p>
</article>

<%- include('parciales/pie') %>
