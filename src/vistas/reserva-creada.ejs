<%- include('parciales/encabezado', { titulo: titulo }) %>

<h1>Reserva registrada</h1>
<p class="mensaje-exito" role="status">
  La reserva <%= reserva.codigoReserva %> quedó registrada en estado «<%= reserva.estado %>».
  Todos sus asientos conservan los vencimientos originales de su selección.
</p>

<%- include('parciales/reserva-info', { reserva: reserva }) %>

<p class="ayuda">El Servicio de correo es simulado: la notificación de registro exitoso quedó registrada, pero no se envía un correo real.</p>

<p>
  <a class="boton" href="/reservas/<%= reserva.codigoReserva %>">Consultar esta reserva</a>
  <a class="volver" href="/cartelera">Volver a la cartelera</a>
</p>

<%- include('parciales/pie') %>
