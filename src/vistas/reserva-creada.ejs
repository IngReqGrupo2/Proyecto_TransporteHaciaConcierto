<%- include('parciales/encabezado', { titulo: titulo }) %>

<h1>Reserva registrada</h1>
<p class="mensaje-exito" role="status">
  La reserva <%= reserva.codigoReserva %> quedó registrada en estado «<%= reserva.estado %>».
  El asiento <%= reserva.asiento.numero %> está retenido hasta las
  <%= formatearFechaHora(reserva.vencimientoRetencion) %>.
</p>

<article class="detalle-viaje">
  <dl>
    <dt>Código de reserva</dt>
    <dd><%= reserva.codigoReserva %></dd>
    <dt>Pasajero</dt>
    <dd><%= reserva.pasajero.nombres %> <%= reserva.pasajero.apellidos %> · RUT <%= reserva.pasajero.rut %></dd>
    <dt>Correo electrónico</dt>
    <dd><%= reserva.pasajero.correoElectronico %></dd>
    <dt>Evento</dt>
    <dd><%= reserva.viaje.eventoNombre %></dd>
    <dt>Viaje</dt>
    <dd><%= reserva.viaje.fechaViaje %> · salida <%= reserva.viaje.horaSalida %> desde <%= reserva.viaje.lugarEncuentro %></dd>
    <dt>Asiento</dt>
    <dd>Asiento <%= reserva.asiento.numero %></dd>
    <dt>Fecha de registro</dt>
    <dd><%= formatearFechaHora(reserva.fechaRegistro) %></dd>
    <dt>Estado</dt>
    <dd><%= reserva.estado %></dd>
  </dl>
</article>

<p class="ayuda">El Servicio de correo es simulado: la notificación de registro exitoso quedó registrada, pero no se envía un correo real.</p>

<p>
  <a class="boton" href="/reservas/<%= reserva.codigoReserva %>">Consultar esta reserva</a>
  <a class="volver" href="/cartelera">Volver a la cartelera</a>
</p>

<%- include('parciales/pie') %>
